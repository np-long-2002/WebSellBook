            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "Password",
            "in": "query",
            "required": true,
            "schema": {
              "minLength": 6,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
